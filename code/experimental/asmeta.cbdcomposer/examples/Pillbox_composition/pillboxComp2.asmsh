setup PILL as examples/Pillbox_composition/pillbox.asm
setup SAFE as examples/Pillbox_composition/safePillbox.asm
run(SAFE, {redLed(compartment1)=OFF;redLed(compartment2)=OFF;name(compartment1)="fosamax";name(compartment2)="moment";time_consumption(compartment1)=[360];time_consumption(compartment2)=[730,1140];drugIndex(compartment1)=0;drugIndex(compartment2)=0})
setup COMP as ( PILL <|> SAFE )
run(COMP, {setNewTime(compartment1)=false;skipNextPill(compartment1)=false;systemTime=361;openSwitch(compartment1)=false;setNewTime(compartment2)=false;skipNextPill(compartment2)=false;openSwitch(compartment2)=false})