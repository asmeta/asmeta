scenario Scheduler_scenario0

load Scheduler.asm

check st(JOB1) = RDY;
check st(JOB2) = RDY;
check idle = false;
check st(JOB3) = RDY;
set fin(JOB1) := true;
pick $j in r_SetRunning(Integer,Boolean) := JOB2;

step

check st(JOB1) = RDY;
check idle = false;
check st(JOB3) = RDY;
check st(JOB2) = RUN;
pick $j in r_SetRunning(Integer,Boolean) := JOB1;

step

check idle = false;
check st(JOB3) = RDY;
check st(JOB1) = RUN;
check st(JOB2) = RUN;
