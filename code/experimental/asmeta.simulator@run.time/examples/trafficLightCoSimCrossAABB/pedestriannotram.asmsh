setup PED as examples/trafficLightCoSimCrossAABB/pedestrian.asm
setup TRAM as examples/trafficLightCoSimCrossAABB/tram.asm
setup CM as examples/trafficLightCoSimCrossAABB/crossManager.asm
setup CONTR as examples/trafficLightCoSimCrossAABB/controller.asm
setup TLA1 as examples/trafficLightCoSimCrossAABB/trafficlightA.asm
setup TLA2 as examples/trafficLightCoSimCrossAABB/trafficlightA.asm
setup TLB1 as examples/trafficLightCoSimCrossAABB/trafficlightB.asm
setup TLB2 as examples/trafficLightCoSimCrossAABB/trafficlightB.asm
setup comp as ( ( ( ( PED || TRAM ) <|> CM ) <||> CONTR ) | ( TLA1 || TLA2 || TLB1 || TLB2 ) )
 
run(comp, {mCurrTimeSecs=1;transitionC=TURN_ON;newPedestrianComing=false;newTramComing=false;crossManagerController=NORMAL;statusC=CONTR_OFF})
run(comp, {mCurrTimeSecs=2;transitionC=OPERATE_T;newPedestrianComing=false;newTramComing=false})
run(comp, {mCurrTimeSecs=3;transitionC=OPERATE_T;newPedestrianComing=false;newTramComing=false})
run(comp, {mCurrTimeSecs=4;transitionC=OPERATE_T;newPedestrianComing=false;newTramComing=false})
run(comp, {mCurrTimeSecs=5;transitionC=OPERATE_T;newPedestrianComing=false;newTramComing=false})
run(comp, {mCurrTimeSecs=6;transitionC=OPERATE_T;newPedestrianComing=true;newTramComing=false})
run(comp, {mCurrTimeSecs=7;transitionC=OPERATE_T;newPedestrianComing=true;newTramComing=false})
run(comp, {mCurrTimeSecs=8;transitionC=OPERATE_T;newPedestrianComing=false;newTramComing=false})
run(comp, {mCurrTimeSecs=9;transitionC=OPERATE_T;newPedestrianComing=false;newTramComing=false})
run(comp, {mCurrTimeSecs=10;transitionC=OPERATE_T;newPedestrianComing=false;newTramComing=false})