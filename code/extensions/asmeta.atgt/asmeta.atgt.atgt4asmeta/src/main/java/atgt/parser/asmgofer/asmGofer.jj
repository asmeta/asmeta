options{  STATIC = false;  // so it can be build
  DEBUG_PARSER = false;  DEBUG_LOOKAHEAD = false;  DEBUG_TOKEN_MANAGER = false;  ERROR_REPORTING = true;  TOKEN_EXTENDS = "";  // to be put as not public (false)  SUPPORT_CLASS_VISIBILITY_PUBLIC = true;}PARSER_BEGIN(AsmGoferParser)package atgt.parser.asmgofer;import atgt.specification.*;import atgt.specification.location.*;import atgt.specification.statement.*;import tgtlib.definitions.expression.*;import tgtlib.definitions.expression.type.EnumConstCreator;import tgtlib.definitions.expression.type.EnumType;import tgtlib.definitions.expression.type.BoolType;import tgtlib.definitions.expression.type.Type;import org.apache.log4j.Logger;public class AsmGoferParser{  static Logger logger = Logger.getLogger(AsmGoferParser.class);  private AsmGoferSpecification SP = new AsmGoferSpecification();  private EnumConstCreator ecc = new EnumConstCreator();  public ASMSpecification getSpecification()  {    return SP;  }  public void resetSpecification()  {    SP = new AsmGoferSpecification();  }}PARSER_END(AsmGoferParser)SKIP :{  " "| "\r"| "\n"| "\t"| < LCOMMENT : "//" (~[ "\n" ])+ "\n" >}TOKEN :{  < EQ : "==" >| < LT : "<" >| < LE : "<=" >| < GT : ">" >| < GE : ">=" >| < NEQ : "!=" >| < AND : "&&" >| < OR : "||" >| < XOR : "xor" >| < NOT : "not" >| < PLUS : "+" >| < MINUS : "-" >| < MULT : "*" >| < DIV : "/" >| < NUMBER : ([ "0"-"9" ])+ >  //|  <COMMENT : "---" (~["\n"])+ "\n">
  //|  <TRUE   :"True"|"TRUE">
  //|  <FALSE  :"False"|"FALSE">
| < DYNAMIC : "Dynamic" >| < INITVAL : "initVal" >| < RULE : "Rule()" >| < DATA : "data" >| < DO : "do" >| < IF : "if" >| < THEN : "then" >| < ELSE : "else" >| < ASMSKIP : "skip" >| < ID : [ "a"-"z", "_" ] ([ "a"-"z", "A"-"Z", "0"-"9", "_" ])* >| < ID_UPPERCASE : [ "A"-"Z", "_" ] ([ "a"-"z", "A"-"Z", "0"-"9", "_" ])* >}String ID() :{  Token t;}{  t = < ID >  {    return t.image;  }}String IDT() :{  Token t;}{  t = < ID_UPPERCASE >  {    return t.image;  }}String VALUE() :{  Token t;}{  (    t = < ID_UPPERCASE >    {      return t.image;    }  | t = < ID >    {      return t.image;    }  | t = < NUMBER >    {      return t.image;    }  )}/** reads the spec in the reader with name SpecName*/void parseSpec() :{}{  [ declarations() ] < EOF >}void declarations() :{}{  (    LOOKAHEAD({ getToken(1).image.equals("instance") })    instanceTerm()  | LOOKAHEAD(< ID > "::" < DYNAMIC >)    varsDecls()  | LOOKAHEAD(< ID > "::" (< ID_UPPERCASE > "->")* < RULE >)    ruleDecls()  | enumDecls()  | comment()  | parseExpression()  | consDecls()  )+}void comment() :{}{  (    "--" directive()  )}void instanceTerm() :{}{  (< ID > < ID_UPPERCASE > < ID_UPPERCASE >)}void directive() :{  Token t1;  Token t2;}{  (    "@interval" "[" t1 = < NUMBER > "," t2 = < NUMBER > "]"    {      SP.setInterval(Integer.parseInt(t1.image), Integer.parseInt(t2.image));    }  | "@delta" t1 = < NUMBER >    {      SP.setDelta(Integer.parseInt(t1.image));    }    /*|
    (<~["\n"]>)+ "\n" {System.out.println("Commento normale");}*/  )}void enumDecls() :{  String name;  EnumType et;}{  (    < DATA > name = IDT() "="    {      et = new EnumType(name);    }    enumList(et)    {      SP.addType(et);    }  )}void enumList(EnumType et) :{  String enumName;}{  enumName = IDT()  {    et.addElement(ecc.createEnumConst(enumName));  }  (    "|" enumName = IDT()    {      et.addElement(ecc.createEnumConst(enumName));    }  )*}void consDecls() :{  String name;  String nameType;  String name1;  String value;}{  (    name = ID() "::" nameType = IDT() name1 = ID() "=" value = VALUE()    {      if (name.equals(name1))      {        Type type = SP.getTypeFor(nameType);        IdExpression fcname = ecc.createIdExpression(name, type);        IdExpression idvalue = ecc.createIdExpression(value, type);        SP.addConstant(new Constant(fcname, type, idvalue));        //System.out.println("SP.addConstant(" + name +", "+nameType+", " +value+")");
      }    }  )}void varsDecls() :{  String name;  String nameType;  String name1;  String value;}{  (    name = ID() "::" < DYNAMIC > nameType = IDT() name1 = ID() "=" < INITVAL > "\"" < ID > "\"" value = VALUE()    {      if (name.equals(name1))      {        Type t = null;        if (nameType.equals("Bool")) t = BoolType.BOOLTYPE;        else t = SP.getTypeFor(nameType);        if (t == null) throw new ParseException("type " + nameType + " not found");        IdExpression varID = ecc.createIdExpression(name, t);        // get the right type        SP.addVariable(new Variable(varID, t, ecc.createIdExpression(value, t)));        logger.debug("SP.addVariable(" + name + ", " + nameType + ", " + value + ")");      }      else      {        throw new ParseException(name + "/=" + name1);      }    }  )}void ruleDecls() :{  String name;  String name1;  BasicRule s;}{  (    name = ID() "::" < RULE > name1 = ID() "=" s = IfStmt()    {      if (name.equals(name1))      {        SP.addRule(new RuleDeclaration(name, s));      }    }  )}BasicRule IfStmt() :{  Expression guard;  BasicRule st;  BasicRule se;  Token tt;  Token te;}{  < IF > guard = logicExpression() tt = < THEN > st = stmt(tt.beginColumn) te = < ELSE > se = stmt(te.beginColumn)  {    return new ConditionalRule(guard, st, se);  }}BasicRule stmt(int column) :{  String e1;  Expression value;  BasicRule s;  DoStatement sd;  Token t;}{  (    LOOKAHEAD({ getToken(1).beginColumn >= column })    (      < ASMSKIP >      {        return Skip.SKIP;      }    | e1 = ID() ":=" value = logicExpression()      {        // Fare l'update per la varibile di nome e1
        Variable var = SP.getVariable(e1);        var.setControlled();        return new UpdateRule(var, value);      }    | LOOKAHEAD(< IF >)      s = IfStmt()      {        return s;      }    | t = < DO >      {        sd = new DoStatement();      }      (        LOOKAHEAD({ getToken(1).beginColumn >= t.beginColumn })        s = stmt(t.beginColumn)        {          sd.addStatement(s);        }      )+      {        return sd;      }    )  )}/* This part is copied from the SCR Grammar  */void parseExpression() :{  Expression m;}{  < IF > m = logicExpression()  {    logger.debug("parsed " + m.toString());  }}// OR
Expression logicExpression() :{  Expression e1;  Expression e2;}{  e1 = andLogicExpr()  (    < OR > e2 = andLogicExpr()    {      e1 = new OrExpression(e1, e2);    }  | < XOR > e2 = andLogicExpr()    {      e1 = new XOrExpression(e1, e2);    }  )*  {    return e1;  }}// AND
Expression andLogicExpr() :{  Expression e1;  Expression e2;}{  e1 = notExpr()  (    < AND > e2 = notExpr()    {      e1 = new AndExpression(e1, e2);    }  )*  {    return e1;  }}//NOT
Expression notExpr() :{  Expression e;}{  (    < NOT > e = logicElement()    {      return NotExpression.createNotExpression(e);    }  | e = logicElement()    {      return e;    }  )}// in SAL it could be a mathExpression
// cfr := != > >= < <=
Expression logicElement() :{  Expression e;  Expression e2;}{  e = mathExpression()  [    < EQ > e2 = mathExpression()    {      e = new EqualsExpression(e, e2);    }  | < NEQ > e2 = mathExpression()    {      e = new NotEqualsExpression(e, e2);    }  | < LT > e2 = mathExpression()    {      e = new LessThanExpression(e, e2);    }  | < LE > e2 = mathExpression()    {      e = new LessEqualExpression(e, e2);    }  | < GT > e2 = mathExpression()    {      e = new GreaterThanExpression(e, e2);    }  | < GE > e2 = mathExpression()    {      e = new GreaterEqualExpression(e, e2);    }  ]  {    return e;  }}Expression mathExpression() :{  Expression m1;  Expression m2;}{  m1 = mathTerm()  (    < PLUS > m2 = mathTerm()    {      m1 = new PlusExpression(m1, m2);    }  | < MINUS > m2 = mathTerm()    {      m1 = new MinusExpression(m1, m2);    }  )*  {    return m1;  }}Expression mathTerm() :{  Expression m1;  Expression m2;}{  m1 = unary()  (    < MULT > m2 = unary()    {      m1 = new MultExpression(m1, m2);    }  | < DIV > m2 = unary()    {      m1 = new DivExpression(m1, m2);    }  )*  {    return m1;  }}Expression unary() :{  Expression m;}{  < MINUS > m = mathElement()  {    return new NegExpression(m);  }| m = mathElement()  {    return m;  }}Expression mathElement() :{  Token t;  Expression m;  String id;}{  (    t = < NUMBER >    {      return ecc.createIdExpression(t.image, null);    }    //| <TRUE>  {return new IdExpression("True");}
    //| <FALSE> {return new IdExpression("False");}
  | id = ID()    {      return ecc.createIdExpression(id, null);    }  | id = IDT()    {      return ecc.createIdExpression(id, null);    }  | "(" m = logicExpression() ")"    {      return m;    }  )}