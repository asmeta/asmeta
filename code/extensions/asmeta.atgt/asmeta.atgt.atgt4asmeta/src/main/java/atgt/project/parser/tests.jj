PARSER_BEGIN(ReadTestsAndTps)package atgt.project.parser;import atgt.coverage.AsmTestSequence;import atgt.coverage.AsmTestCondition;import tgtlib.definitions.expression.*;import tgtlib.definitions.expression.type.EnumConstCreator;/** reads the extra information:test predicates andtest already generated (till now only for combinatorial testing)*/public class ReadTestsAndTps{  private static EnumConstCreator ecc;}PARSER_END(ReadTestsAndTps)SKIP :{  " "| "\r"| "\t"| "\n"| < LCOMMENT : "//" (~[ "\n" ])+ "\n" >}// for expressionsTOKEN :{  < LT : "<" >| < LE : "<=" >| < GT : ">" >| < GE : ">=" >| < NEQ : "!=" >| < AND : "AND" >| < OR : "OR" >| < NOT : "NOT" >| < PLUS : "+" >| < MINUS : "-" >| < MULT : "*" >| < DIV : "/" >  //|  <TRUE   :"True"|"TRUE">  //|  <FALSE  :"False"|"FALSE">}TOKEN : /* OPERATORS */{  < EQ : "=" >| < TEST : "test" >| < TG : "testgoal" >| < ID : ([ "a"-"z", "A"-"Z", "0"-"9", "_" ])+ >}ExtraTests readInfo() :{  // TODO pass the spec so it can read the ID from the spec  ecc = new EnumConstCreator();  ExtraTests info = new ExtraTests();  Token t, t2;  UserDefinedTps udtp = new UserDefinedTps("user defined tests");  Expression e;}{  (    < TEST > t = < ID >    {      AsmTestSequence ts = new AsmTestSequence(null);      ts.addState();    }    ":"    (      t = < ID > < EQ > t2 = < ID >      {        ts.addAssignment(t.toString(), t2.toString());      }    )    (      "," t = < ID > < EQ > t2 = < ID >      {        ts.addAssignment(t.toString(), t2.toString());      }    )*    ";"    {      info.addTestSequence(ts);    }  | < TG > t = < ID > ":" e = parseLogicExpression()    {      udtp.addTestCondition(new AsmTestCondition(t.toString(), e));    }    ";"    {}  )*  {    info.addCoverage(udtp);    return info;  }}// Copiata dal parser delle expressioni di ASMGOFER// NON SO COME FARE altrimenti .... come includere /////////////////////////////// ORExpression parseLogicExpression() :{  Expression e1;  Expression e2;}{  e1 = andLogicExpr()  (    < OR > e2 = andLogicExpr()    {      e1 = new OrExpression(e1, e2);    }  )*  {    return e1;  }}// ANDExpression andLogicExpr() :{  Expression e1;  Expression e2;}{  e1 = notExpr()  (    < AND > e2 = notExpr()    {      e1 = new AndExpression(e1, e2);    }  )*  {    return e1;  }}//NOTExpression notExpr() :{  Expression e;}{  (    < NOT > e = logicElement()    {      return  NotExpression.createNotExpression(e);    }  | e = logicElement()    {      return e;    }  )}// in SAL it could be a mathExpression// cfr := != > >= < <=Expression logicElement() :{  Expression e;  Expression e2;}{  e = mathExpression()  [    < EQ > e2 = mathExpression()    {      e = new EqualsExpression(e, e2);    }  | < NEQ > e2 = mathExpression()    {      e = new NotEqualsExpression(e, e2);    }  | < LT > e2 = mathExpression()    {      e = new LessThanExpression(e, e2);    }  | < LE > e2 = mathExpression()    {      e = new LessEqualExpression(e, e2);    }  | < GT > e2 = mathExpression()    {      e = new GreaterThanExpression(e, e2);    }  | < GE > e2 = mathExpression()    {      e = new GreaterEqualExpression(e, e2);    }  ]  {    return e;  }}Expression mathExpression() :{  Expression m1;  Expression m2;}{  m1 = mathTerm()  (    < PLUS > m2 = mathTerm()    {      m1 = new PlusExpression(m1, m2);    }  | < MINUS > m2 = mathTerm()    {      m1 = new MinusExpression(m1, m2);    }  )*  {    return m1;  }}Expression mathTerm() :{  Expression m1;  Expression m2;}{  m1 = unary()  (    < MULT > m2 = unary()    {      m1 = new MultExpression(m1, m2);    }  | < DIV > m2 = unary()    {      m1 = new DivExpression(m1, m2);    }  )*  {    return m1;  }}Expression unary() :{  Expression m;}{  < MINUS > m = mathElement()  {    return new NegExpression(m);  }| m = mathElement()  {    return m;  }}Expression mathElement() :{  Token t;  Expression m;}{  (    //  t = <NUMBER>{ return new IdExpression(t.image);}    //	| <TRUE>  {return new IdExpression("True");}    //	| <FALSE> {return new IdExpression("False");} |     t = < ID >    {      return ecc.createIdExpression(t.image,null);    }  | "(" m = parseLogicExpression() ")"    {      return m;    }  )}
