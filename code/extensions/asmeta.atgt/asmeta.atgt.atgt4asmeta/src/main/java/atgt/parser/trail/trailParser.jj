options{  DEBUG_PARSER = false;  DEBUG_LOOKAHEAD = false;  DEBUG_TOKEN_MANAGER = false;  ERROR_REPORTING = true;  STATIC = false;}PARSER_BEGIN(TrailParser)package atgt.parser.trail;import java.util.Collection;import java.util.HashMap;import java.util.Map;import tgtlib.generator.MCAnalysisResult;import atgt.coverage.AsmCoverageTree;import atgt.coverage.AsmTestSequence;import atgt.coverage.TestCondition;import atgt.parser.trail.CexParser;import atgt.specification.location.Location.VarKind;import atgt.specification.location.Variable;public class TrailParser implements CexParser < AsmTestSequence >{  AsmCoverageTree tcIndex;  // useful to keep track of the variables  private Map<String,Variable> variables = new HashMap<String, Variable>();  public void setVariables(Collection<Variable> variables) {    for(Variable v: variables)    {      this.variables.put(v.getName(),v);    }  }}PARSER_END(TrailParser)SKIP :{  " "| "\r"| "\n"| "\t"}TOKEN :{  < SPIN_LINE :    "spin:" (~[ "\n", "\r" ])+    (      "\n"    | "\r"    | "\r\n"    ) >| < PAN_LINE :    "pan:" (~[ "\n", "\r" ])+    (      "\n"    | "\r"    | "\r\n"    ) >| < NUMBER : ("-")? ([ "0"-"9" ])+ >| < ID : [ "a"-"z", "A"-"Z" ] ([ "a"-"z", "A"-"Z", "0"-"9", "_" ])* >| < NEW_STATE : "_New_State" >| < UPDATE_VALUE : "_Update_value" >| < MON_VAR_UPDATE : "_Monitored_value_update:" >| < COVERED : "_Covered:" >}/** read the test result with name name */MCAnalysisResult analysis(AsmCoverageTree tcIndex, AsmTestSequence tr) :{  this.tcIndex = tcIndex;}{  [ < SPIN_LINE > ]  {    tr.addState();  }  (    assignment(tr)  | otherCoverage(tr)  | < NEW_STATE >    {      tr.addState();      //System.out.println("reading trail state "+nstate++);
    }  )+  (    < SPIN_LINE >  | < PAN_LINE >  )  {    return MCAnalysisResult.found();  }}void states(AsmTestSequence tr) :{}{  (    (      assignment(tr)    )+    (      otherCoverage(tr)    )+  )}void assignment(AsmTestSequence tr) :{}{  (    LOOKAHEAD(< UPDATE_VALUE >)    valueUpdate(tr)  | LOOKAHEAD(< MON_VAR_UPDATE >)    monVarUpdate(tr)  )}void valueUpdate(AsmTestSequence tr) :{}{  (    < UPDATE_VALUE > assignmentPair(tr, VarKind.CONTROLLED)  )}void monVarUpdate(AsmTestSequence tr) :{}{  (    < MON_VAR_UPDATE > assignmentPair(tr, VarKind.MONITORED)  )}void assignmentPair(AsmTestSequence tr, VarKind vt) :{  Token t1;  Token t2;  Token t3;  String var;}{  (    t1 = < ID >    {      var = new String(t1.image);    }    [      "["      (        t3 = < NUMBER >      | t3 = < ID >      )      "]"      {        var += "[" + t3.image + "]";      }    ] // the values may be another ID in case of enumerative
    (      t2 = < NUMBER >    | t2 = < ID >    )    {      //System.out.println(t1.image + " := " + t2.image);
      tr.addAssignment(variables.get(var), t2.image);      //ch.monitoredValueChanged(t1.image, t2.image);
    }    [ "." ]  )}void otherCoverage(AsmTestSequence tr) :{  Token t1;  Token t2;}{  (    < COVERED > t1 = < ID > t2 = < NUMBER >    {      if (t2.image.equals("1"))      {        TestCondition tc = tcIndex.findTestCondition(t1.image);        tc.bindTestSeqTestPred(tr);      }    }  )}
